# Python bytecode
__pycache__/
*.py[cod]

# Local savings ledger. NEVER commit this: the `command` column stores every
# Bash command ltc compressed, verbatim, including absolute paths and anything
# else that appeared on the command line. On a work machine that is the
# employer's information, and publishing it is the one way this repo could leak
# something it has no right to.
ltc_stats.db
*.ltc_stats.db

# Per-call metadata sidecars written by `ltc compress`
*.ltc.meta.json

# Real captured command output (scripts/capture_corpus.py). Same reasoning as
# the ledger above: this is verbatim output from a real machine — absolute
# paths, branch names, package lists. samples/ is synthetic and publishable;
# corpus/ is local-only measurement data and must never be committed. Kept as a
# sibling of samples/ rather than a child, so the harness cannot wander into it
# and so there is no path by which a real capture lands in a published sample.
corpus/

# Local Claude Code settings (machine-specific paths and permissions)
.claude/settings.local.json

# Virtualenvs / build
.venv/
venv/
build/
dist/
*.egg-info/
